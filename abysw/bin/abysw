			if len(sys.argv) == 3:
				cmd_id = sys.argv[2]
			elif len(sys.argv) == 4:
				cmd_id = sys.argv[2]
				lowcov = int(sys.argv[3])
			else:
				exit(ahelp.help(sys.argv[1]))
			fo = open(cmd_id, 'r')
			head = fo.readline()
			print (head, end = '')
			for i in fo:
				line = i.strip().split()
				ck = 0
				for j in line[1:len(line)-1]:
					if int(j) > lowcov:	ck += 1
					if int(j) == 0: ck += 1
				if ck == 0:
					print (i, end = '')

# RBH
		elif sys.argv[1] == "rbh":
			if len(sys.argv) == 4:
				f_m8 = sys.argv[2]
				r_m8 = sys.argv[3]
				f_dict = {}
				r_dict = {}
				fo = open(f_m8, 'r')
				for line in fo:
					lines = line.strip().split()
					if lines[0] not in r_dict.keys():
						r_dict[lines[0]] = lines[1]
				fo = open(r_m8, 'r')
				for line in fo:
					lines = line.strip().split()
					if lines[0] not in f_dict.keys():
						f_dict[lines[0]] = lines[1]
						if lines[1] in r_dict.keys():
							if lines[0] != r_dict[lines[1]]:
								continue
							if len(lines) > 10:
								print ("\t".join([lines[1], lines[0], lines[2], lines[10]]))
							else:
								print ("\t".join([lines[1], lines[0]]))

			else:
				exit(ahelp.help(sys.argv[1]))
			

