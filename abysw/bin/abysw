def splitgvcf(args):
	[gvcf] = args
	prefix_re = re.match("([^\.]+)", gvcf)
	prefix = prefix_re.group(1)
	fo = os.popen("gunzip -c " + gvcf, 'r')
	chr = {}
	ID = 'Pchr'
	chr["Pchr"] = ""
	print ("Welcome to use abyssTools, have a nice experience!\n")
	print ("For a quick experience, split_gvcf.pl is recommended:\n")
	os.system("abysw perl")
	print ("split_gvcf.pl " + gvcf)
	for line in fo:
		if "#" in line:
			re_id = re.match("##contig=<ID=((\w*)\d+),length=", line)
			if re_id:
				if ID == "Pchr":
					ID = re_id.group(2)
				if re_id.group(2) == ID:
					chr[re_id.group(1)] = ""
		else:
			break
	fo = os.popen("gunzip -c " + gvcf, 'r')
	check = ''
	for line in fo:
		if "#" in line:
			if "contig" in line:
				re_id = re.match("##contig=<ID=((\w*)\d+)", line)
				if re_id:
					if re_id.group(1) in chr.keys():
						chr[re_id.group(1)] += line
					else:
						chr["Pchr"] += line
			else:
				for i in chr.keys():
					chr[i] += line
		else:
			break

	for i in chr.keys():
		ft = open(prefix + "." + i + ".g.vcf", 'w')
		ft.write(chr[i])
	fo = os.popen("gunzip -c " + gvcf, 'r')
	check = ''
	for line in fo:
		if "#" in line:
			continue
		else:
			lines = line.split()
			i = lines[0]
			if i in chr.keys():
				if i in line:
					if check != i:
						ft = open(prefix + "." + i + ".g.vcf", 'a')
						check = i
					ft.write(line)
					chr[i] += line
			else:
				if check != "Pchr":
					ft = open(prefix + "." + i + ".g.vcf", 'a')
					check = i
				ft.write(line)

def add(args):
	[file1, file2, key1, target1, key2] = args[0:5]
	fo = open(file1, 'r')
	key1 = int(key1) - 1
	key2 = int(key2) - 1
	target1 = int(target1) - 1
	target = {}
	for line in fo:
		line = line.strip()
		line = line.split('\t')
		if len(line) != 4:
			continue
		target[line[key1]] = line[target1]
	fo = open(file2, 'r')
	for line in fo:
		line = line.strip()
		line = line.split('\t')
		target2 = "NA"
		if line[key2] in target.keys():
			target2 = target[line[key2]]
		print ("\t".join(line[0:key2+1]) + "\t" + target2 + "\t" + "\t".join(line[key2 + 1:]))

def dlssr(args):
	file = args[0]
	print (file)
	fo = open(file, "r")
	for line in fo:
		line = line.strip()
		ft = open(line + ".sh", "w")
		ft.write("export PATH=/xulab/pipeline/soft/sratoolkit.2.11.0-centos_linux64/bin:$PATH\nprefetch -O . " + line + "\n")
		ft.write("cd {}; fastq-dump {}.sra --split-3 --gzip -A {} -O {}; cd {}; mv {}_1.fastq.gz {}_1.fq.gz; mv {}_2.fastq.gz {}_2.fq.gz; cd ..; mv {}.sra ..".format(line, line, line, line, line, line, line, line, line, line))
		ft.write("echo -ne \"Finishd at \"; date\nmv {}.sh {}.sh.done\n".format(line, line))

def fam(args):
	[f_fam, f_chara, number] = args[0:3]
	re_fam = re.match("(\S+).fam", f_fam)
	ff_fam = f_fam
	if re_fam:
		ff_fam = re_fam.group(1)
	print ("cp " + ff_fam + ".fam." + number + ".tmp " + f_fam)
	print ("gemma -bfile " + ff_fam + " -gk 2 -o kinship_" + number)
	print ("gemma -bfile " + ff_fam + " -lmm -k output/kinship_" + number + ".sXX.txt -o GWAS_" + number)
	print ("abysw manhattan output/GWAS_" + number + ".assoc.txt ", end = "")
	global a_defalt
	if args == 4:
		if args[3] == "-d":
			a_defalt = 1
	number = int(number) - 1
	chara = {}
	homo = {}
	fo = open(f_chara, 'r')
	head = 0
	for line in fo:
		line = line.strip()
		line = line.split("\t")
		if len(line) <= number:
			continue
		if head == 0:
			print ("\"" + line[number] + "\" " + f_fam)
			head = 1
		chara[line[0]] = line[number]
		homo[line[number]] = line[number]
	j = 0
	for i in sorted(homo.keys()):
		if i != "":
			j = j + 1
			homo[i] = j

	if a_defalt == 1:
		for i in chara.keys():
			chara[i] = homo[chara[i]]
	
	ft = open(f_fam + "." + str(number + 1) + ".tmp", 'w')
	fo = open(f_fam, 'r')
	for line in fo:
		line = line.strip()
		line = line.split()
		line[5] = "-9"
		if line[0] in chara.keys():
			re_homo = re.match("\S+", str(chara[line[0]]))
			if not re_homo:
				line[5] = "-9"
			else:
				line[5] = str(chara[line[0]])
				if line[5] == "NA" or line[5] == "na" or line[5] == "Na":
					line[5] = "-9"
		ft.write("\t".join(line) + "\n")
	if a_defalt == 1:
		ft = open(f_chara + str(number + 1) + ".tmp", 'w')
		for i in sorted(homo.keys()):
			ft.write(i + "\t" + str(homo[i]) + '\n')

def gatk(args):
	[reference, fastq, outprefix] = args
	cmd = abyss_path + "/shell/resequencing.cmd.sh " + " ".join([reference, fastq, outprefix])
	os.system (cmd)

def pca(args):
	name = args[0]
	cmd = "plink --vcf " + name 
	re_name = re.match('(\S+).vcf', name)
	if re_name:
		name = re_name.group(1)
	cmd += " --make-bed --out " + name + ".snp --allow-extra-chr\n"
	cmd += "gcta64 --bfile " + name + ".snp --make-grm --autosome --out " + name + ".tmp\n"
	cmd += "gcta64 --grm " + name + ".tmp --pca 3 --out " + name + ".pca\n"
	cmd += "#abysw pcagroup group.list " + name + ".pca.eigenvec > "  + name + ".pca.eigenvec\n"
	cmd += '''for i in {1..9};do echo "admixture --cv ''' + name + '''.snp.bed $i |tee ''' + name + '''log${i}.out &";done | sh\n'''
	print (cmd)

def ld(args):
	[vcf, group] = args[0:2]
	cmd = "PopLDdecay -InVCF " + vcf + " -SubPop " + group + " -MaxDist 1000 -OutStat " + group + ".stat"
	print (cmd)

def snpeff(args):
	if len(args) == 1:
		ahelp.help(snpeff)
		sys.exit("abysw snpeff ref.name file.vcf")
	ref, vcf = args
#	print ("/abysw/soft/snpEff/exec/snpeff ann " + ref + " " + vcf + " -s " + vcf + ".ann.summary.html > " + vcf + ".ann.vcf")

	os.system("~/.abysw/soft/snpEff/exec/snpeff ann " + ref + " " + vcf + " -s " + vcf + ".ann.summary.html > " + vcf + ".ann.vcf")

def qs(args):
	list = args
	mydir = os.getcwd()
	for line in list:
		host = os.popen('hostname')
		info = host.readline()
		info = info.strip('\n')
		re_dir = re.search('(\S+)\/([^\/]+)$',line)
		dir = os.getcwd()
		if re_dir:
			re_d = re.search('^\/',re_dir.group(1))
			if re_d:
				dir = re_dir.group(1)
			else:
				dir += '/' + re_dir.group(1)
			i = re_dir.group(2)
		else:
			i = line
		os.chdir(dir)
		if os.path.exists("abyss"):
			cmd = "";
		else:
			cmd = 'mkdir abyss; '
		cmd += 'echo cd ' + dir + ' > abyss/' + i + ';cat ' + i + ' >> abyss/' + i + '; cd abyss;'
		cmd += "qsub -l mem=" + args[0] + "G,nodes=1:ppn=" + args[1] + " " + i
		cmd += ';cd ..;'
		os.system(cmd)
		os.chdir(mydir)

def chd(args):
	dir_new = args[0]
	cmd = ''
	cmd += """ sed -i '/^alias\ """ + dir_new + """=/d' ~/.bash_profile\n"""
	if len(args) == 2 and args[1] == "del":
		print ("delete old alias " + dir_new)
	elif len(args) == 1:
		print ("add new alias directory name: " + args[0])
		cmd += """ sed -i '$a alias\ """ + dir_new + """="cd """ + os.getcwd() + """"' ~/.bash_profile """
	else:
		sys.exit("please check your command !")
	os.system(cmd)
	print ("source ~/.bash_profile")

def wig2bed(args):
	[file] = args[0:1]
	fo = open(file)
	for line in fo:
		line = line.strip()
		re_head = re.search('chrom=(\S+)\s+start=(\d+)',line)
		if re_head:
			chr = re_head.group(1)
			i = re_head.group(2)
			i = int(i)-1
		else:
			print ("{}\t{}\t{}\t{}".format(chr, i, i+1, line))
			i += 1

def unqid(args):
	[file] = args[0:1]
	fo = open(file)
	dict_id = {}
	for line in fo:
		line = line.strip()
		list = line.split()
		if list[0] not in dict_id.keys():
			dict_id[list[0]] = []
		dict_id[list[0]].append(list[1])
	for i in dict_id.keys():
		print (i + "\t", end = "")
		print (";".join(dict_id[i]))

def callcbs(args):
	[msa] = args[0:1]
	fo = open(msa)
	len_r = 0
	check = 0
	for line in fo:
		line = line.strip()
		re_head = re.match(r'(\S)', line)
		if re_head:
			head = re_head.group()
		if head == '#':
			print (line)
		elif not re_head:
			if len(seq_id) >= 5 and check > 0:
				print (block)
			len_r = 0
		else:
			list = line.split( )
			if head == 'a':
				block = line + "\n"
				seq_r = ''
				seq_id = []
			elif head == 's':
				if len_r == 0:
					len_r = int(list[3])
					seq_r = list[6]
					for i in range(0,len(seq_r)):
						re_i = re.match(r'[ATCGatcg]', seq_r[i])
						if re_i:
							seq_id.append(i)
					block += line + "\n"
					if not 'Medicago_truncatula' in line:
						seq_id = []
					check = 0
				else:
					seq_q = list[6]
					count = 0
					if 'null' in seq_q:
						continue
					for i in seq_id:
						re_i = re.match(r'[ATCGatcg]', seq_q[i])
						if re_i:
							count += 1
						if count >= 5 and count/len(seq_id) >= 0.5:
							block += line + "\n"
							check += 1
	print ("##eof maf")

def end(args):
	[fasta] = args[0:1]
	a_del = ""
	if len(args) > 1:
		a_del = int(args[1])
	fo = open(fasta, 'r')
	id = ""
	seq = ""
	text = ""
	for line in fo:
		re_id = re.match('>(\S+)', line)
		if re_id:
			if (len(id) > 0):
				text = re.sub('[\.\*]+\n$', '\n', text)
				re.text = re.search('\.', text)
#				if re.text and a_del:
#					print ('', end = '')
				if re.text and a_del:
					if a_del > 0:
						print ('', end = '')
					else:
						text = re.sub('[\.\*]', '', text)
						print (">" + id + "\n" + text , end = "")
				else:
					print (">" + id + "\n" + text , end = "")
			text = ""
			seq = ""
			id = re_id.group(1)
		else:
			text += line
			line = line.strip()
			seq += line
	if (len(id) > 0):
		text = re.sub('[\.\*]+\n$', '\n', text)
		re.text = re.search('\.', text)
#		if re.text and a_del:
#			print ('', end = '')
		if re.text and a_del:
			if a_del > 0:
				print ('', end = '')
			else:
				text = re.sub('[\.\*]', '', text)
				print (">" + id + "\n" + text , end = "")
		else:
			print (">" + id + "\n" + text , end = "")

def sort(args):
	[sort_list, file] = args[0:2]
	number = 0
	if len(args) > 2:
		number = int(args[2])
	sort_dict = {}
	fo = open(file, 'r')
	for line in fo:
		line = line.strip()
		list = line.split()
		sort_dict[list[number]] = line
	fo = open(sort_list, 'r')
	for line in fo:
		line = line.strip()
		if line in sort_dict.keys():
			print (sort_dict[line])
		else:
			if len(args) > 3:
				print (line + "\t" + args[3])

def miss(args):
	[file1, file2] = args
	fo = open(file1, 'r')
	miss_dict = {}
	for line in fo:
		miss_dict[line] = 1
	fo = open(file2, 'r')
	for line in fo:
		if line not in miss_dict.keys():
			print (line, end = '')

def getfa(args):
	[gene, fasta] = args
	gene_id = {}
	if os.path.exists(gene):
		fo = os.popen("cat " + gene)
		#fo = open(gene, 'r')
		for line in fo:
			re_id = re.match('(\S+)', line)
			if re_id:
				gene_id[re_id.group(1)] = 1
	else:
		gene_id[gene] = 1
	fo = open(fasta, 'r')
	id = ""
	seq = ""
	text = ""
	for line in fo:
		re_id = re.match('>(\S+)', line)
		if re_id:
			if (len(id) > 0 and id in gene_id.keys()):
				print (">" + id + "\n" + text , end = "")
			elif(len(id) > 0):
				sys.stderr.write(">" + id + "\n" + text)
			text = ""
			seq = ""
			id = re_id.group(1)
		else:
			text += line
			line = line.strip()
			seq += line
	if (len(id) > 0 and id in gene_id.keys()):
		print (">" + id + "\n" + text , end = "")
	elif (len(id) > 0):
		sys.stderr.write(">" + id + "\n" + text)

def gffid(args):
	file = args[0]
	file = args[0]
	name = ''
	if len(args) == 2:
		name = args[1]
	else:
		name = re.search('(\w\w)[^\_\/]*\_(\w\w\w)[^\/]+$',file)
		name = name.group(1) + name.group(2)
		id_re_x = re.search('(\w\w)[^\_\/]*\_x\_(\w\w\w)[^\/]+$', file)
		if id_re_x:
			name = id_re.group(1) + id_re.group(2) #id_re.group(2) + id_re.group(1)
	fo = open(file,"r")
	for line in fo:
		re_head = re.match('^#', line)
		if re_head:
			continue
		line = line.strip()
		text = line.split("\t")
		if len(text) < 8:
			continue
		id_name = re.match('([^\|\s]+)',text[0])
		if id_name:
			text[0] = name + '_' + id_name.group(1)
		re_id = re.search('ID=([^\;]+)', text[8])
		re_pr = re.search('Parent=([^\s\;]+)', text[8])
		re_rna = re.search('RNA', text[2])
		if text[2] == "gene":
			if re_id:
				text[8] = "ID=" + name + '_' + re_id.group(1) + ";"
		elif re_rna:
			if re_id:
				text[8] = "ID=" + name + '_' + re_id.group(1) + ";"
			if re_pr:
				text[8] += 'Parent=' + name + '_' + re_pr.group(1) + ";"
		else: 
			if re_pr:
				text[8] = 'Parent=' + name + '_' + re_pr.group(1) + ";"
			else:
				if re_id:
					text[8] = "Parent=" + name + '_' + re_id.group(1) + ";"
		print ('\t'.join(text))

def faid(args):
	fa = args[0]
	new_id = ''
	if len(args) >= 2 and  args[1] != '0':
		new_id = args[1]
	else:
		id_re = re.search('(\w\w)[^\_\/]*\_(\w\w\w)[^\/]+$',fa)
		new_id = id_re.group(1) + id_re.group(2)
		id_re_x = re.search('(\w\w)[^\_\/]*\_x\_(\w\w\w)[^\/]+$',fa)
		if id_re_x:
			new_id = id_re.group(1) + id_re.group(2) #id_re.group(2) + id_re.group(1)
	file_o = open(fa,"r")
	length = 0
	seq = ''
	new_name = ''
	mylen = 0
	if len(args) > 2:
		mylen = int(args[2])
	for line in file_o:
		id_name = re.match('\>([^\|\s]+)',line)
		if id_name:
			if length > mylen:
				print (">" + new_name)
				print (seq, end = '')
			length = 0
			seq = ''
			new_name = new_id + "_" + id_name.group(1)
		else:
			length += len(line) -1
			seq += line
	if length > mylen:
		print (">" + new_name)
		print (seq)

def f_fa(args):
	[fa, cut] = args
	fo = open(fa)
	id = ""
	seq = ""
	text = ""
	for line in fo:
		re_id = re.match('>(\S+)', line)
		if re_id:
			if (len(seq) >= int(cut) and len(id) > 0):
				print (">" + id + "\n" + text , end = "")
			elif id:
				sys.stderr.write(">" + id + "\n" + text)
			text = ""
			seq = ""
			id = re_id.group(1)
		else:
			text += line
			line = line.strip()
			seq += line
	if (len(seq) >= int(cut) and len(id) > 0):
		print (">" + id + "\n" + text , end = "")
	else:
		sys.stderr.write(">" + id + "\n" + text)

def fa2phy(args):
	"""
	%prog fa2phy *.fa > *.phy
	"""
	fo = open(sys.argv[2])
	count = 0
	seq = ""
	text = ""
	for line in fo:
		re_id = re.match('>(\S+)', line)
		if re_id:
			id = re_id.group(1)
			count = count + 1
			text += "\n" + id + '    '
			seq = ""
		else:
			line = line.strip()
			text += line
			seq += line
	print (str(count) + "    " + str(len(seq)) + text )

def phy2fa(args):
	"""
	%prog phy2fa *.phy > *.fa
	"""
	head = "yes"
	fp = open(sys.argv[2])
	if len(args) == 2:
		nohead = args[1]
	if head != "yes":
		fp.readline()
	for line in fp:
		list = line.split()
		print (">" + list[0])
		print (list[1])

def spgff(args):
	fp = open(sys.argv[2])
	dict_chr = {}
	for line in fp:
		re_ot = re.match('(\S+)', line)
		re_head = re.match('#', line)
		if re_head:
			continue
		if re_ot:
			if not re_ot.group(1) in dict_chr.keys():
				to = open(re_ot.group(1) + ".gff", 'w+')
				dict_chr[re_ot.group(1)] = 1
			else:
				to = open(re_ot.group(1) + ".gff", 'a')
			to.writelines(line)
def get_cds_from_gff(agrs):
	fp = open(sys.argv[2])
	re_file = re.match('(\S+).gff', sys.argv[2])
	if re_file:
		fo = open(re_file.group(1) + '.cds', 'w')
	re_file = re.match('(\S+).bed', sys.argv[2])
	if re_file:
		fo = open(re_file.group(1) + '.cds', 'w')
	dict_gene = {}
	for line in fp:
		list = line.split('\t')
		re_gff = re.match('^\d+$', list[1])
		if re_gff:
			dict_gene[list[3]] = 1
		else:
			re_gene = re.search('ID=([^;\s]+)', line)
			if re_gene:
				dict_gene[re_gene.group(1)] = 1
	fp.close()
	fp = open(sys.argv[3])
	for line in fp:
		re_gene = re.search('\>(\S+)', line)
		if re_gene:
			id_gene = re_gene.group(1)
			if id_gene in dict_gene.keys():
				fo.writelines(line)
		else:
			if id_gene in dict_gene.keys():
				fo.writelines(line)			

### genelist, bed file, length[500000]
def get_bed_from_gene_list(args):
	fp = os.popen('grep -f ' + sys.argv[2] + ' ' + sys.argv[3])
	scaf = {}
	#re_file = re.match('(\S+).gff', sys.argv[2])
	for line in fp:
		line = line.strip()
		line = line.split('\t')
		if not line[0] in scaf.keys():
			scaf[line[0]] = {}
		scaf[line[0]]['gene'] = line[3]
		scaf[line[0]]['start'] = int(line[1]) - int(sys.argv[4])
		scaf[line[0]]['end'] = int(line[2]) + int(sys.argv[4])
	fp.close()
	fp = open(sys.argv[3])
	for line in fp:
		lines = line
		line = line.strip()
		line = line.split('\t')
		if line[0] in scaf.keys():
			ft = open(scaf[line[0]]['gene'] + '.bed', 'a')
			if int(line[2]) > scaf[line[0]]['start'] and int(line[1]) < scaf[line[0]]['end']:
				ft.write(lines)
	
def get_gene_flank(args):
	gene_list, bed, upstream, downstream = args
	fp = os.popen('grep -f ' + gene_list + ' ' + bed)
	tmp1, tmp2 = upstream, downstream
	for lines in fp:
		line = lines.strip()
		line = line.split('\t')
		re_dig = re.match('^\d+$', line[1])
		l_str = line[1]
		l_end = line[2]
		if re_dig: # bed file
			if line[5] == "-":
				upstream, downstream = tmp2, tmp1
			#line[1] = line[1] + upstream
			else:
				upstream, downstream = tmp1, tmp2
			if upstream == "not":
				line[1] = l_end #line[2]
			else:
				line[1] = str(int(line[1]) - int(upstream))
			if int(line[1]) < 0:
				line[1] = '0'
			if downstream == "not":
				line[2] = l_str #line[1]
			else:
				line[2] = str(int(line[2]) + int(downstream))
		else:      # gff file 
			l_str = line[3]
			l_end = line[4]

			if line[6] == "-":
				upstream, downstream = tmp2, tmp1
			else:
				upstream, downstream = tmp1, tmp2
			if upstream == "not":
				line[3] = l_end
			else:
				line[3] = str(int(line[3]) - int(upstream))
			if int(line[3]) < 0:
				line[3] = '0'
			if downstream == "not":
				line[4] = l_str
			else:
				line[4] = str(int(line[4]) + int(downstream))
		print ('\t'.join(line))

def linkfa(args):
	sp_list, fa_files = args
	fp = open(sp_list) #species list
	species_s = []
	for i in fp:
		i = i.strip('\n')
		list = re.split('\s+',i)
		for j in list:
			species_s.append(j)
	muscle_file = fa_files # 'ls *le'
	fp1 = os.popen(muscle_file)

	count = 0
	dict_s = {}
	dict_sp = {}
	for line in fp1:
		if not os.path.getsize:
				continue
		line = line.strip('\n')
		fpf = open(line)
		seq = ''
		id = ''
		seq_l = 0
		dict_s = {}
		#print line
		for linef in fpf:
#			id_re = re.match('>\S+\_(\w\w\w\w\w)',linef)
			id_re = re.match('>(\w\w\w\w\w)',linef)
			if id_re:
				if len(seq) > 0:
#					seq = re.sub(r'^ATG|TAA$|TAG$|TGA$','---',seq)
					dict_s[id] = seq
					seq_l = len(seq)
				seq = ''
				id = id_re.group(1)
			else:
				seq_s = linef.strip('\n')
				seq += seq_s
		if len(seq) > 0:
#			seq = re.sub(r'^ATG|TAA$|TAG$|TGA$','---',seq)
			dict_s[id] = seq
			seq_l = len(seq)
		seq = ''

		for i in species_s:
			re_sp = re.search('(\w\w)[a-z]*\_(\w\w\w)',i)
			id = ''
			if re_sp:
				id = re_sp.group(1) + re_sp.group(2)
			else:
				id = i
			if not i in dict_sp.keys():
				dict_sp[i] = ''
			if id in dict_s.keys():
				dict_sp[i] += dict_s[id]
			else:
				dict_sp[i] += '-'*seq_l
	print ('{}\t{}'.format(len(species_s), len(dict_sp[species_s[0]])))
	for i in species_s:
		print (i + '    ' + dict_sp[i])
def maf2bed(args):
	msa = args[0]
	fi = open(msa)
	check = 0
	for line in fi:
		re_head = re.match(r'a', line)
		if check == 1:
			line = line.strip()
			line = line.split()
			#print (line)
			print (line[1] + '\t' + line[2] + "\t" + str(int(line[2]) + int(line[3])))
			check = 0
		if re_head:
			check = 1
def gb2gff(args):
	gb = args[0]
	global chr
	block = ""
	chr = ""
	seq = ""
	id = ""
	pep = ""
	gff = ""
	ft1= open (gb + ".gff3", "w")
	ft2= open (gb + ".fa", "w")
	ft3= open (gb + ".pep", "w")
	ft4= open (gb + ".gff", "w")
	fo = open (gb)
	for line in fo:
		if "VERSION" in line:
			line = line.strip()
			line = line.split()
			chr = line[1]
			continue
		if len(line) > 5 and line[5].isalpha():
			line = line.strip()
			if chr in block:
				continue
				block = ""
			else:
				[pep, gff] = block_a(block)
				ft1.write(gff)
				if gff:
					if "\tgene\t" in gff:
						gff = gff.replace("\tgene\t", "\tmRNA\t")
						gff = gff.strip()
						gffs = gff.split("\n")
						start = 0
						end = 0
						jj = []
						for j in gffs:
							jj = j.split("\t")
							if len(jj) < 9:
								continue
							if len(jj) == 9:
								if start == 0 or int(jj[3]) < start:
									start = int(jj[3])
								if int(jj[4]) > end:
									end = int(jj[4])
						if len(jj) == 9:
							ft4.write("\t".join([jj[0], jj[1], jj[2], str(start), str(end), jj[5], jj[6], jj[7], jj[8]]) + "\n")
					elif "\tCDS\t" in gff:
						gff = gff.replace("ID=", "Parent=")
						ft4.write(gff)
				if pep:
					ft3.write(pep)
				block = line
		else:
			line = line.strip()
			block += line
		if "ORIGIN" in line:
			seq = "".join(fo.readlines())
	
	seq = re.sub("[\d\s\/]", "", seq)
	ft2.write(">" + chr + "\n" + seq + "\n")
	[pep, gff] = block_a(block)
	ft1.write(gff)
	ft3.write(pep)


def block_a(args):
	block = args
	blocks = block.split("/")
	pep = ""
	gff = ""
	if len(blocks) > 3:
		gene = blocks[0].split()[0]
		loc = blocks[0].split()[1]
		pep = re.search("\/translation=\"([^\"]+)\"", block)
		if pep:
			id = re.search("\/gene=\"([^\"]+)\"", block)
			if id:
				id = id.group(1)
			pep = pep.group(1)
			pep = (">" + id + "\n" + pep + "\n")
		for i in loc.split(","):
			start = i.split("..")[0]
			start = re.findall(r"\d+", start)[-1]
			end = i.split("..")[1]
			end = re.findall(r"\d+", end)[0]
			id = blocks[1]
			id = id.replace("\"", "")
			id = id.replace("gene", "ID")

			gff += ("\t".join([chr, "gb2gff", gene, str(start), str(end), ".", "+", ".", id ]) + "\n")
	return [pep, gff]

