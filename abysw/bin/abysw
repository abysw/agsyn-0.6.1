			elif len(sys.argv) == 2:
				dir_new = os.getcwd()
				re_dir = re.search('\S+\/([^\/]+$)', dir_new)
				if re_dir:
					dir_new = re_dir.group(1)
				chd([dir_new])
			elif len(sys.argv) >= 3:
				chd(sys.argv[2:])
		elif sys.argv[1] == "sh":
			if len(sys.argv) == 2:
				print ('''abysw sh number''')
			else:
				number = os.popen('ls *sh | wc -l')
				if len(sys.argv) >= 4:
					number = os.popen('ls ' + "\t".join(sys.argv[3:]) + ' | wc -l')
				number = number.read()
				re_num = re.match('(\d+)', number)
				number = int(re_num.group(1)) / int(sys.argv[2])
				number = int(number)
				cmd_sh = ('if [ -e zshell ];then rm -r zshell;fi; mkdir zshell; ls *sh | perl -ne \'chomp;$j++;$i+=' + str(number) + ''' if $j>$i;`echo "echo jobs-start; sh $_ > $_.log 2> $_.err; echo jobs-finished" >> zshell/zz.shell.$i` if $j<=$i; \' ''')
