				cmd = ''' for i in `ls ''' + sys.argv[2] + ''' | sed s/.gff$//`;do echo "samtools faidx $i.fa && gffread $i.gff -g $i.fa -x $i.cds -y $i.pep 2> $i.err && echo $i"; done '''
