import ahelp
from string import Template

a_version = ahelp.c_cyan("ABYSsWrapper version is 0.7.3 20240225 upgraded version")
a_help = ahelp.c_red("Please type `abysw -h` for more information")
def printusage():
	
	print (ahelp.a_head(a_version))
	print (c_white(
"""
usage:  abysw command option
	-a --add [s]                         * add prematers 
	-n --number [i]                      * number
	-i --input [s]                       * input files
	-o --output [s]                      * output file prefix or total name
	-p --prefix [s]                      * files' prefix
	-s --suffix [s]                      * files' suffix
	-r --reference [s]                   * reference genome file
	-d --default                         * default 
	-v --version                         * print version information
	-h --help                            * print detail help information
	a.                                   * genome Wrapper (a.), assembly & annotation
	c.                                   * change format Wrapper (c.)
	e.                                   * evalute & extract Wrapper (e. & ex.)
	f.                                   * filter Wrapper (f.)
	l.                                   * link Wrapper (l.)
	s.                                   * statistics Wrapper (s.)

	abysw active                         * for activing future ABYSsWrapper environment
"""))

#################### color set ################################
def c_red(word):
	return ("""\033[1;31m""" + word + """\033[0m""")
def c_green(word):
	return ("""\033[1;32m""" + word + """\033[0m""")
def c_yellow(word):
	return ("""\033[1;33m""" + word + """\033[0m""")
def c_blue(word):
	return ("""\033[1;34m""" + word + """\033[0m""")
def c_magenta(word):
	return ("""\033[1;35m""" + word + """\033[0m""")
def c_cyan(word):
	return ("""\033[1;36m""" + word + """\033[0m""")
def c_white(word):
	return ("""\033[1;37m""" + word + """\033[0m""")

col_list = ("black", "red", "green", "yellow", "blue", "magenta", "cyan", "white")
j_ab = -1
word = ' '.join(sys.argv[2:])
if len(sys.argv) < 2:
	sys.exit(printusage())

for i in col_list:
    j_ab = j_ab + 1
    if sys.argv[1] == i:
        print ("""\033[1;3""" + str(j_ab) + """m""" + word + """\033[0m""")
        exit()


#################### furture command set  ######################
def shell_(cmd_id):
	_shell_ = os.popen('ls ' + abyss_path + '/../share/agsyn/*/abysw.' + cmd_id + '{.pl,.py,.sh,.R,.shell.pl}  2> /dev/null | tail -n 1')
	_shell_ = _shell_.readline()
	_shell_ = _shell_.strip()
	return _shell_

def read_shell(cmd_cmd):
	read_shell_ = os.popen(cmd_cmd)
	read_shell_ = read_shell_.readline()
	read_shell_ = read_shell_.strip()
	return read_shell_

#################### global variable  ##########################
date_ = read_shell('date +%Y-%m-%d\ %k:%M')

a_defalt = 0
a_number = 0
a_input = ""
a_output = ""
a_reference = ""
a_add = ""
def main(argv):
	
	global a_defalt
	global a_number
	global a_input
	global a_output
	global a_reference
	global a_prefix
	global a_suffix
	global a_add
	global date_
	global aw_
	global aw_help
	aw_help = {}
	aw_ = ""
	try:
		opts, args = getopt.getopt(argv,"hvdn:i:o:r:",["help","version","defalt","number", "input", "output", "prefix", "suffix","reference", "add"])
	except getopt.GetoptError:
		printusage()
		print (a_help)
		sys.exit(2)
	for opt, arg in opts:
		if opt in ('-h', "--help"):
			printusage();
			ahelp.genome();
			ahelp.change_format();
			ahelp.draw();
			ahelp.evalute()
			ahelp.filter();
			ahelp.compare()
			ahelp.genefamily()
			ahelp.syntenic()
			ahelp.statistics()
			ahelp.resequence()
			ahelp.standin()
			ahelp.task()
			ahelp.unclass()

			sys.exit()
		elif opt in ('-v', "--version"):
			print (a_version)
			sys.exit()
		elif opt in ('-n', '--number'):
			a_number = arg
			sys.argv.remove('-n')
			sys.argv.remove('--number')
		elif opt in ("-d", "--defalt"):
			a_defalt = 1
			sys.argv.remove('-d')
			sys.argv.remove('--defalt')
		elif opt in ("-i", "--input"):
			a_input = arg
			sys.argv.remove("-i")
			sys.argv.remove("--input")
		elif opt in ("-o", "--output"):
			a_output = arg
			sys.argv.remove("-o")
			sys.argv.remove("--output")
		elif opt in ("-p", "--prefix"):
			a_prefix = arg
			sys.argv.remove("-p")
			sys.argv.remove("--prefix")
		elif opt in ("-s", "--suffix"):
			a_suffix = arg
			sys.argv.remove("-s")
			sys.argv.remove("--suffix")
		elif opt in ("-r", "--reference"):
			a_reference = arg
			sys.argv.remove("-r")
			sys.argv.remove("--reference")
		elif opt in ("-a", "--add"):
			a_add = arg
			sys.argv.remove("-a")
			sys.argv.remove("--add")


	global abyss_path
#	abyss_path = sys.path[0]
	abyss_path = os.path.dirname(os.path.abspath(__file__))
#	abyss_path = abyss_path.replace("/home/" + os.getlogin(), "~")
#	abyss_path = re.sub(rf'^/home/yuanfu', '~', abyss_path, count=1)
#	abyss_path = re.sub(rf'^/home/{re.escape(os.getlogin())}', '~', abyss_path, count=1)
#script_directory_shortened = re.sub(rf'^/home/{re.escape(os.getlogin())}/', '~', os.path.dirname(os.path.abspath(__file__)), count=1)

#################### default set ######################
	if len(sys.argv) < 2:
		sys.exit(printusage())
	else:
		if sys.argv[1] == "list":
			os.system(abyss_path + "/abysw -h  | less | grep 32 | cat")
		elif sys.argv[1] in "help":
			printusage()
		elif sys.argv[1] in "resequence":
			ahelp.resequence()
		elif sys.argv[1] in "genome":
			ahelp.genome()
		elif sys.argv[1] in "change_format":
			ahelp.change_format()
		elif sys.argv[1] in "draw":
			ahelp.change_format()
		elif sys.argv[1] in "evalute":
			ahelp.evalute()
		elif sys.argv[1] in "filter":
			ahelp.filter()
		elif sys.argv[1] in "statistics":
			ahelp.statistics()
		elif sys.argv[1] in "syntenic":
			ahelp.syntenic()
		elif sys.argv[1] in "genefamily" and len(sys.argv) == 2:
			ahelp.genefamily()
		elif sys.argv[1] in "standin":
			ahelp.standin()
		elif sys.argv[1] in "comparate":
			ahelp.comparate()
		elif sys.argv[1] in "unclass":
			ahelp.unclass()
		elif sys.argv[1] == "task":
			ahelp.task()
###############################################################################################
### from local script #########################################################################
###############################################################################################

########################## no parameter #####################
### conda activate
		elif sys.argv[1] == "ca":
			os.system("conda activate " + sys.argv[1] + '''; PS1="\[\e[1;35m\][\[\e[1;33m\]\\u@Yuan-SW-F $DATE \A \[\e[1;36m\]\w\[\e[1;35m\]]\[\e[1;31m\]\n\$ \[\e[0m\]" && [[ $CONDA_DEFAULT_ENV ]] && PS1="($CONDA_DEFAULT_ENV)"$PS1''')
### snap
		elif sys.argv[1] == "snap" or sys.argv[1] == "maker":
			cmd_id = sys.argv[1]
			if len(sys.argv) == 2:
				os.system ("perl " + shell_(cmd_id))
			else:
				os.system ("perl " + shell_(cmd_id) + " " + sys.argv[2])

### stat.busco
		elif sys.argv[1] == "stat.busco" or sys.argv[1] == "s.busco" or sys.argv[1] == "s.b":
			cmd_id = "stat.busco"
			if len(sys.argv) == 2:
				os.system ("perl " + shell_(cmd_id))
			elif len(sys.argv) >= 2:
				for i in sys.argv[2:]:
					os.system ("perl " + shell_(cmd_id) + " " + i)
			else:
				print (c_blue("please use busco enviroment"))
				ahelp.help(sys.argv[1])
				print (c_green("abysw " + cmd_id + " sequence"))

### sumbed
		elif sys.argv[1] == "sumbed":
			if len(sys.argv) == 2:
				cmd = """awk '{i+=1;j+=$3-$2}END{print i"\t"j}' """
				os.system(cmd)
			else:
				ahelp.help(sys.argv[1])
				print ("cat file.bed |abysw sumbed              # statistics bed file")

### sumgff
		elif sys.argv[1] == "sumgff":
			if len(sys.argv) == 2:
				cmd = """ awk '{i+=1;j+=$5-$4+1}END{print i"\t"j}' """
				os.system(cmd)
			else:
				ahelp.help(sys.argv[1])
### matrix
		elif sys.argv[1] == "matrix":
			if len(sys.argv) == 2:
				cmd_matrix="""perl -e 'while (<>){$h{$1}{$2} = $3 if /(\S+)\s+(\S+)\s+(\S+)/; $check{$2} =1;} ;  print join "\t", "class", sort(keys %check); print "\n"; for $i(sort (keys %h)){print $i; for $j(sort (keys %check)){print exists $h{$i}{$j} ? "\t$h{$i}{$j}" : "\t0";} print "\n"}'"""
				os.system(cmd_matrix)

### nohup
		elif sys.argv[1] == "nohup":
			if len(sys.argv) == 2:
				os.system('''for i in `ls *sh`;do echo "nohup sh $i > $i.log 2> $i.err &"; done''')
			else:
				os.system('''for i in `ls ''' + "\t".join(sys.argv[2:]) + '''`;do echo "nohup sh $i > $i.log 2> $i.err &"; done''')

### lst
		elif sys.argv[1] == "lst":
			if len(sys.argv) == 2:
				os.system(""" perl -e 'while (<STDIN>){ if (/\n/){ $n++; chomp; push @i,$_; }else{ push @i,$_; } } if ($n<2){ $l=$i[0]; @i=split /\s+/,$l; $l=join "\n",@i; print "$l\n"; }else{ $l=join " ",@i; print "$l\n"; }' """)
		
### togff
		elif sys.argv[1] == "togff":
			type = 'mRNA'
			if sys.argv == 3:
				type = sys.argv[2]
			os.system('''perl -ne '@l=split;if ($l[2] eq "''' + type + '''"){print "$l[0]\t";$l[8]=~/=([^\;\s]+)/;print "$1\t$l[3]\t$l[4]\t$l[6]\n"} ' ''')

		elif sys.argv[1] == "rev":
			os.system("perl -ne 'chomp;$i=$_; $i=~tr/[ATCG]/[TAGC]/; $i=reverse($i);print $i'")
		elif sys.argv[1] == "hi2fa":
			os.system("""awk '/^S/{print \">\"$2\"\\n\"$3}'""")
		elif sys.argv[1] == "fqlen":
			os.system("perl -ne '$i = <>;$len = length($i); <>; <>; print \"$len\\n\"' | awk '{i++; j+=$1}END{print i\"\\t\"j}'")
		elif sys.argv[1] == "ipr":
			if len(sys.argv) <  3:
				ahelp.help("ipr")
			else:
				print ('export PATH=/abysw/soft/annotation/interproscan-5.56-89.0:$PATH;\ninterproscan.sh -i ' + sys.argv[2] + ' -b ' + sys.argv[2] + '.iprscan -goterms -iprlookup -pa -dp -cpu 24')
		elif sys.argv[1] == "orthofinder":
			if len(sys.argv) >= 3:
				ahelp.help(sys.argv[1])
			else:
				print ("orthofinder -t 250 -a 250 -d -f ./ -S diamond")

#                elif sys.argv[1] == "dl.genome":
#                    if len(sys.argv) >= 3:
#                        print ("datasets download genome taxon snakes --assembly-level chromosome,complete --include gff3,protein --filename snakes.zip")
####################################################################
		elif sys.argv[1] == "a.":
			ahelp.genome()
		elif sys.argv[1] == "b.":
			print (c_green("blast et al.: compare sequence (b.)"))
			print (c_white("\tb.blastn\n\tb.bwa\n\tb.minimap2"))
		elif sys.argv[1] == "c.":
			ahelp.change_format()
		elif sys.argv[1] == "d.":
			ahelp.draw()
		elif sys.argv[1] == "e.":
			ahelp.evalute()
		elif sys.argv[1] == "f.":
			ahelp.filter()
		elif sys.argv[1] == "l.":
			print (c_green("link files (l.)"))
			print (c_white("l.chr"))
		elif sys.argv[1] == "s.":
			ahelp.statistics()
		elif sys.argv[1] == "syn.":
			ahelp.syntenic()
		elif sys.argv[1] == "log":
			ahelp.alog()
		elif sys.argv[1] == "simple":
			print(ahelp.simple())
		elif sys.argv[1] == "more":
			print(ahelp.more())
		elif sys.argv[1] == "manual" or sys.argv[1] == "m.":
			ahelp.manual()
		elif sys.argv[1] == "ahelp":
			os.system("vi " + abyss_path + "/ahelp.py")
		elif sys.argv[1] == "blog" and len(sys.argv) == 2:
			ahelp.blog()
		
		elif sys.argv[1] == "sample":
			os.system("ls " + abyss_path + """/../* | perl -ne 'if ($_!~/\//){print "    ";}print'""")
		elif sys.argv[1] in ["R", "assembler", "combin", "shell", "perl", 'python']:
			print ('export PATH=' + abyss_path + "/../" + sys.argv[1] + ':$PATH')
		elif sys.argv[1] == "env":
			print ("source " + abyss_path + """/config.txt""")
		elif sys.argv[1] == "path":
			print (abyss_path)
		elif sys.argv[1] == "active":
			cmd = 'source ' + abyss_path + '/../../abysw.cfg'
			print (cmd)
		elif sys.argv[1] == "sum":
			if len(sys.argv) == 2:
				print ("abysw sum [tophat,] file")

####################################################################
		elif len(sys.argv) == 2:
			ahelp.help(sys.argv[1])
		elif len(sys.argv) == 3 and sys.argv[2] == "-h":
			ahelp.help(sys.argv[1])

		elif sys.argv[1] == "cmd":
			os.system (' '.join(sys.argv[2:]))

####################################################################################
#################### bio subs ######################################################
####################################################################################
### augustus
		elif sys.argv[1] == "augustus":
			cmd_id = "augustus"
			if len(sys.argv) == 3:
				species_ = sys.argv[2]
				if not os.path.exists('Trinity.fasta'):
					print ("please make sure if you has Trinity.fasta")
				if not os.path.exists(species_ + "_genome.fa"):
					print ("please make sure if you has " + species_ + "_genome.fa")
				print ("start for augustus train of " + species_)
				os.system ("sh " + shell_(cmd_id) + " " + species_)

### 3dDNA
		elif sys.argv[1] == "3dDNA" or sys.argv[1] == "hicpro":
			cmd_id = sys.argv[1]
			if len(sys.argv) == 3:
				os.system ("sh " + shell_(cmd_id) + " " + sys.argv[2])

### hifiasm
		elif sys.argv[1] == "hifiasm":
			cmd_id = sys.argv[1]
			if len(sys.argv) >= 3:
				print (c_blue("Start assembly:\n"))
				print (date_ + "\tInput file is " + sys.argv[2])
				if len(sys.argv) == 4:
					print (date_ + "\tKmer is " + sys.argv[3])
				else:
					print (date_ + "\tKmer is 51")
				os.system ("sh " + shell_(cmd_id) + " " + ' '.join(sys.argv[2:]))

### trinity
		elif sys.argv[1] == "trinity":
			cmd_id = sys.argv[1]
			if len(sys.argv) >= 3:
				os.system ("sh " + shell_(cmd_id) + " " + ' '.join(sys.argv[2:]))

##### EDTA
		elif sys.argv[1] == "edta":
			cmd_id = sys.argv[1]
			if len(sys.argv) == 3:
				tempTemplate = Template("EDTA.pl --genome $i --overwrite 1 --sensitive 1 --anno 1 --evaluate 1 --threads 50")
				os.system (tempTemplate.substitute(i=sys.argv[2]))

### gmap
		elif sys.argv[1] == "gmap":
			cmd_id = sys.argv[1]
			if len(sys.argv) == 4:
				os.system ("sh " + shell_(cmd_id) + " " + ' '.join(sys.argv[2:]))

### close
		elif sys.argv[1] == "close":
			cmd_id = sys.argv[1]
			if len(sys.argv) == 4:
				tempTemplate = Template("sambamba markdup -r -t 40 $sam $sam.mk.bam\nsamtools view -S -b -q 30 -o $sam.mk-ft.bam.bam $sam.mk.bam\nsamtools index $sam.mk-ft.bam.bam\n/abysw/app/miniconda3/envs/java8/bin/java -Xmx10G -jar /abysw/jar/pilon-1.24.jar --genome $ref --jumps  $sam.mk-ft.bam.bam --fix snps,indels --output ${ref}_polished --vcf")
				os.system (tempTemplate.substitute(sam=sys.argv[2], ref=sys.argv[3]))

### cdhit
		elif sys.argv[1] == "cdhit":
			cmd_id = sys.argv[1]
			if len(sys.argv) == 4:
				os.system ("sh " + shell_(cmd_id) + " " + ' '.join(sys.argv[2:]))

### reseq
		elif sys.argv[1] == "reseqs":
			cmd_id = sys.argv[1]
			if len(sys.argv) >= 4:
				os.system ("sh " + shell_(cmd_id) + " " + ' '.join(sys.argv[2:]))
			else:
				print (c_blue("please use gatk4 enviroment"))
				print (c_green("abysw " + cmd_id + " refence fastq out step"))
				print (c_green("Step:"))
				print (c_white("\t##### step 0: filter reads #####\n\t##### step 1: Map to Reference ####\n\t##### step 2: *** Mark Duplicates *** #####\n\t##### step 3: call SNP by mpileup #####\n\t##### step 4: *** BQSR,ReduceReads *** #####\n\t##### step 5: HaplotypeCaller #####"))

		elif sys.argv[1] == "gffread":
			cmd_id = sys.argv[1]
			if len(sys.argv) == 3:
				tempTemplate = Template("gffread $ref.gff -g $ref.fa -x $ref.cds -y $ref.pep")
				os.system (tempTemplate.substitute(ref=sys.argv[2]))
############################ genome ##########################################
##### assembly RNA
		elif sys.argv[1] == "a.rna":
			cmd_id = sys.argv[1]
			if len(sys.argv) >= 4:
				os.system ("sh " + shell_(cmd_id) + " " + ' '.join(sys.argv[2:]))

##### assembly meta
		elif sys.argv[1] == "a.meta":
			cmd_id = sys.argv[1]
			if len(sys.argv) >= 4:
				os.system ("sh " + shell_(cmd_id) + " " + ' '.join(sys.argv[2:]))
			else:
				print (c_green("abysw " + cmd_id + " reference.fa query.fa"))

##### ann iso
		elif sys.argv[1] == "iso":
			cmd_id = "isoform"
			if len(sys.argv) >= 4:
				os.system ("sh " + shell_(cmd_id) + " " + ' '.join(sys.argv[2:]))
			else:
				print (c_green("abysw " + cmd_id + " RNAID genome_fasta"))

##### genemark
		elif sys.argv[1] == "gmark":
			if len(sys.argv) == 3:
				os.system("gmes_petap.pl --ES --sequence " + ' '.join(sys.argv[2:]))
			else:
				print (c_green("abysw " + sys.argv[1] + " genome_fasta"))
############################ blast et al.: compare sequence ######################
##### blastn for short reads
		elif sys.argv[1] == "blastn":
			cmd_id = sys.argv[1]
			if len(sys.argv) >= 4:
				eva = "1e-5"
				if len(sys.argv) == 5:
					eva = sys.argv[4]
				tempTemplate = Template("[[ -s $pa1.nin ]] || [[ -s $pa1.00.nin ]] || makeblastdb -in $pa1 -dbtype nucl > db.log\nblastn -db $pa1 -query $pa2 -evalue $pa3 -outfmt 6 -num_threads 64 > $pa10.$pa20.m8")
				re_pa1 = re.search('([^\/]+)$', sys.argv[2])
				re_pa2 = re.search('([^\/]+)$', sys.argv[3])
#				os.system (tempTemplate.substitute(pa1=sys.argv[2], pa2=sys.argv[3], pa3=eva))
				os.system (tempTemplate.substitute(pa1=sys.argv[3], pa2=sys.argv[2], pa3=eva, pa10=re_pa1.group(1), pa20=re_pa2.group(1)))
			else:
				ahelp.help(cmd_id)

		elif sys.argv[1] == "diomand":
			cmd_id = sys.argv[1]
			if len(sys.argv) >= 4:
				eva = "1e-5"
				if len(sys.argv) == 5:
					eva = sys.argv[4]
				tempTemplate = Template("[[ -e $pa1.dmnd ]] || diamond makedb -d  $pa1 --in $pa1 > db.log\ndiamond blastp -d $pa1 -q $pa2 -e $pa3 > $pa10.$pa20.m8")
				re_pa1 = re.search('([^\/]+)$', sys.argv[2])
				re_pa2 = re.search('([^\/]+)$', sys.argv[3])
				os.system (tempTemplate.substitute(pa1=sys.argv[3], pa2=sys.argv[2], pa3=eva, pa10=re_pa1.group(1), pa20=re_pa2.group(1)))
			else:
				ahelp.help(cmd_id)

#diamond makedb -d $P --in $P 2>/dev/null
#    diamond blastx -b 0.5 -d $P -q $G -o $G.blast --threads
##### blastp for short protein
		elif sys.argv[1] == "blastp":
			cmd_id = sys.argv[1]
			if len(sys.argv) >= 4:
				eva = "1e-5"
				if len(sys.argv) == 5:
					eva = sys.argv[4]
				tempTemplate = Template("[[ -e $pa1.pin ]] || makeblastdb -in $pa1 -dbtype prot > db.log\nblastp -db $pa1 -query $pa2 -evalue $pa3 -outfmt 6 -num_threads 64 > $pa10.$pa20.m8")
				re_pa1 = re.search('([^\/]+)$', sys.argv[2])
				re_pa2 = re.search('([^\/]+)$', sys.argv[3])
#				os.system (tempTemplate.substitute(pa1=sys.argv[2], pa2=sys.argv[3], pa3=eva))
